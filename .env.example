# =============================================================================
# BE (Node / Express) — copy thành .env trên server (Railway, Render, VPS…)
# =============================================================================
# Lưu ý deploy:
# - Vercel không phù hợp cho app Express + SQLite + cron dài như repo này (cần server luôn chạy + ổ đĩa).
# - Nên deploy BE lên Railway / Render / Fly.io / VPS, rồi gán URL đó vào FE (VITE_API_BASE_URL).
# =============================================================================

# Cổng HTTP (mặc định 3001)
PORT=3001

# API nguồn doanh thu (Consims)
SOURCE_API_URL=https://consims.com/api/get-data-test

# Độ lệch ±% cho khoảng tin cậy trong phân tích (số)
FORECAST_CONFIDENCE_PCT=5

# Google Gemini — CHỈ trên server, không bao giờ đưa vào FE
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# JWT — bắt buộc chuỗi dài, ngẫu nhiên trên production (openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite — chỉ cho MVP / demo cục bộ. Scale hoặc nhiều instance: nên đổi sang DB quản lý (Postgres…).
# PaaS: cần persistent disk / volume trỏ vào thư mục chứa file này.
SQLITE_PATH=data/app.db

# ---------------------------------------------------------------------------
# Tuỳ chọn: CORS — danh sách origin FE, cách nhau bởi dấu phẩy (không có dấu cách thừa)
# Ví dụ sau khi deploy FE lên Vercel:
# CORS_ORIGINS=https://central-retail.vercel.app,https://www.yourdomain.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=
